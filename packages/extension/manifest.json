{
  "manifest_version": 3,
  "name": "Shopping Agent",
  "version": "0.1.0",
  "description": "Side panel client and browser tool host for Shopping Agent",
  "permissions": ["sidePanel", "storage", "tabs", "scripting"],
  "host_permissions": [
    "http://localhost:8100/*",
    "http://127.0.0.1:8100/*",
    "https://search.jd.com/*",
    "https://item.jd.com/*",
    "https://www.ebay.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel/sidepanel.html"
  },
  "action": {
    "default_title": "Shopping Agent"
  },
  "options_page": "options/options.html"
}
