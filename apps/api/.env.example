SA_MOCK_BROWSER=true
SA_DATABASE_URL=postgresql://shopping:shopping@localhost:5432/shopping_agent
# Prefer: cd apps/api && alembic upgrade head
# Opt-in runtime CREATE TABLE (not for production):
SA_AUTO_CREATE_SCHEMA=false
SA_LOG_LEVEL=INFO
# Extension WebSocket auth (recommended; set the same token in extension options)
SA_EXTENSION_TOKEN=
# When true, reject requests without SA_EXTENSION_TOKEN (including session GETs).
SA_AUTH_REQUIRED=false
# Optional: exact Chrome extension ID, e.g. abcdefghijklmnop
SA_EXTENSION_ID=
# Empty key interrupts turns with llm_unavailable. Set a key to enable the LLM agent.
SA_LLM_API_KEY=
SA_LLM_BASE_URL=https://api.openai.com/v1
SA_LLM_MODEL=gpt-4o-mini
SA_AGENT_MAX_STEPS=14
# Live browse pacing (per site) and job timeout:
# SA_BROWSE_MIN_INTERVAL_S=2.0
# SA_BROWSE_JITTER_S=0.6
# SA_JOB_TIMEOUT_S=60
# Live JD browse (requires Chrome extension connected via WS):
# SA_MOCK_BROWSER=false
# Persistence tests (optional):
# SA_TEST_DATABASE_URL=postgresql://shopping:shopping@localhost:5432/shopping_agent_test
